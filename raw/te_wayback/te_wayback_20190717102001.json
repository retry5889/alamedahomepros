    var LAST_VISIBLE = new Date().getTime();

    function saveSocketNetworkBW() {

        if (TE_URL.indexOf("calendar") > -1) return;
        if (TE_URL.indexOf("stream") > -1) return;
        if (TE_URL.indexOf("/currencies") > -1) return;
        if (TE_URL.indexOf("/stocks") > -1) return;
        if (TE_URL.indexOf("/bonds") > -1) return;
        if (TE_URL.indexOf("/commodities") > -1) return;

        setInterval(function () {
            if (typeof document == 'undefined' || !document) return LAST_VISIBLE = new Date().getTime();
            if (typeof document.hidden != 'boolean') return LAST_VISIBLE = new Date().getTime();

            //console.log('document.hidden', document.hidden, typeof document.hidden);
            if (!document.hidden) {

                if (!IS_CONNECTED) {
                    console.log('GOING IN!');
                    socket.connect();
                }

                return LAST_VISIBLE = new Date().getTime();
            }

            var now = new Date().getTime();
            if (now - LAST_VISIBLE > KILL_SOCKET_AFTER_IDLE) {
                if (IS_CONNECTED) {
                    console.log('GOING OUT!');
                    socket.disconnect();
                }
            }

        }, 1000 * 1);
    }

    saveSocketNetworkBW();

</script>






