                        modalContent += "Clients can also use an <b>API</b> to have direct access to our data, to query our real-time economic calendar and to subscribe to updates from any programming language.";

                        modalFooter += "<div style='text-align:center;'><div class='btn-group'><a class='btn btn-default' href='https://web.archive.org/web/20210329202025/https://tradingeconomics.com/analytics/features.aspx' target='_blank'>Learn More</a>";
                        modalFooter += "<a class='btn btn-default' href='https://web.archive.org/web/20210329202025/https://tradingeconomics.com/analytics/pricing.aspx' target='_blank'>Pricing</a>";
