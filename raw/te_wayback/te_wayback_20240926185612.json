        function buildDownloadButton(container) {
            if (isLoggedIn) {
                var downloadBtn = $("<a id='HyperLinkToDownload' href='https://web.archive.org/web/20240926185612/https://api.tradingeconomics.com/calendar' class='btn btn-info' data-download='csv'><i class='bi bi-download'></i><span class='d-none d-lg-inline'>&nbsp;Download</span></a>");
