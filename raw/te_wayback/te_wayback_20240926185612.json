        tab += '<li class="dropdown-item"><a href="#" data-download="api"><img src="https://web.archive.org/web/20240926185612/https://d3fy651gv2fhd3.cloudfront.net/images/downloadicons/download-api.svg" alt="API download button" style="height: 25px; width: 25px">&nbsp;&nbsp;API Access</a></li>'
