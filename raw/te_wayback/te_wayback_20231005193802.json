            // THIS IS A HACK SO WE DONT NEED TO REWRITE THE LINK BUILT IN THIS MOMENT
            var currCsvDownload = $("#data a.export-btn-csv").attr("href");
            if (currCsvDownload)
                csvLink = $("<li><a href='" + currCsvDownload + "' data-download='csv' target='_blank'><img src='https://web.archive.org/web/20231005193802/https://d3fy651gv2fhd3.cloudfront.net/images/downloadicons/download-csv-filled.svg' alt='CSV download button' style='height: 25px; width: 25px'>&nbsp;&nbsp;Download Data</a></li>");
            var downloadList = $("<ul id='menu-download-dropdown' class='dropdown-menu'>");
