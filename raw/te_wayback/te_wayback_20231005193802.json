            var excelLink = $("<li><a href='#' data-download='excel'><img src='https://web.archive.org/web/20231005193802/https://d3fy651gv2fhd3.cloudfront.net/images/downloadicons/microsoft-excel-filled.svg' alt='Excel download button' style='height: 25px; width: 25px'>&nbsp;&nbsp;Excel Add-in</a></li>");
