            let offcanvas = document.querySelector(".offcanvas.offcanvas-start.show");
            if (offcanvas && !offcanvas.contains(event.target)) {
                let closeButton = document.querySelector('.offcanvas-header .btn-close');
                if (closeButton) {
                    closeButton.click();
                }
            }
        });

        accordionHeaders.forEach(function (header) {
