<script>
    // DOC ready
    document.addEventListener("DOMContentLoaded", function (event) {
        // remove calendar tab if no calendar is present
        var calendarTab = document.querySelector("li a[href='#calendar-table']");
        if (!hasCalendar && calendarTab) {
            var li_parent = calendarTab.closest('li');
            li_parent.remove();

            console.log('calendar removed using js..');
        }

        // active deactivate calendar on scroll
        var previousActive = document.querySelector(".pagetabs li.active")
        var section = document.querySelectorAll(".section");
        var sections = {};

        Array.prototype.forEach.call(section, function (e) {
            sections[e.id] = e.offsetTop;
        });

        // scroll event
        window.onscroll = function () {
            var scrollPosition = document.documentElement.scrollTop || document.body.scrollTop;

            var i = 0;
            for (i in sections) {
                var section_anchor = document.querySelector('.pagetabs li a[href*=' + i + ']');

                if (section_anchor && sections[i] <= scrollPosition && sections[i] + 350 >= scrollPosition) {

                    var activeTab = document.querySelector(".pagetabs li.active");
                    if (!previousActive || activeTab.querySelector("a").getAttribute("href") != "#" + i)
                        previousActive = activeTab;
                    previousActive.classList.remove("active");

                    var section_anchor = document.querySelector('.pagetabs li a[href*=' + i + ']');
                    if (section_anchor)
                        section_anchor.closest('li').classList.add('active');

                } else {
                    section_anchor.closest('li').classList.remove('active');

                    // search to see if there is already a active li, this means that a tab was clicked
                    var activeTabs = document.querySelectorAll(".pagetabs li.active");
                    if (activeTabs && activeTabs.length > 0)
                        previousActive = activeTabs[0]
                    else
                        previousActive.classList.add('active');
                }
            }
        };

        //// check if the url has a #something, and if there is a tab with the same #something, and simulate a click on the tab
        //var hash = window.location.hash;
